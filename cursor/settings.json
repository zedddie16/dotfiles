{
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1
    },
    "editor.guides.indentation": false,
    "workbench.iconTheme": "material-icon-theme",
    "workbench.tips.enabled": false,
    "workbench.startupEditor": "newUntiltedFile",
    "workbench.editor.showTabs": "none",
    "window.commandCenter": false,
    "window.restoreWindows": "none",
    "editor.lineNumbers": "relative",
    
    // hide title bar
    "window.titleBarStyle": "native",   
    "window.menuBarVisibility": "toggle", // press alt to reveal (wont work if prev is native)
    // remove scrollbar 
    "editor.scrollbar.vertical": "hidden",
    "editor.scrollbar.horizontal": "hidden",
    "editor.scrollbar.verticalScrollbarSize": 0,
    "editor.scrollbar.horizontalScrollbarSize": 0,
    // Scrolloff 
    "editor.cursorSurroundingLines": 21,
    
    // Neovim extension specific settings
    "vscode-neovim.neovimExecutablePaths.linux": "/usr/bin/nvim",
    "vscode-neovim.neovimInitVimPaths.linux": "~/.config/nvim/init.lua",
    
    // Configure via neovim init 
    "vscode-neovim.neovimCleanInitVim": false,
    
    // Additional scrolling settings to help with centering
    "editor.scrollBeyondLastLine": false,
    "workbench.colorTheme": "One Dark Pro Night Flat",
    "editor.stickyScroll.enabled": false,
    "workbench.statusBar.visible": false,
    "breadcrumbs.enabled": false,
    
}