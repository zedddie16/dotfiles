[
    /*
    {
        "key": "ctrl+i",
        "command": "-composerMode.agent"
    },
    {
        "key": "ctrl+l", 
        "command": "-workbench.action.chat.newChatEditor"
    },
    {
        "key": "ctrl+k",
        "command": "-editor.action.showHover"
    },
    {
        "key": "ctrl+shift+l",
        "command": "-editor.action.insertCursorAtEndOfEachLineSelected"
    },
    {
        "key": "ctrl+shift+k",
        "command": "-editor.action.deleteLines"
    },
    {
        "key": "ctrl+e",
        "command": "-workbench.action.quickOpen"
    },
    {
        "key": "ctrl+/",
        "command": "-editor.action.commentLine"
    },
    */

    {
        "key": "ctrl+alt+i",
        "command": "composerMode.agent"
    },
    {
        "key": "ctrl+alt+l",
        "command": "workbench.action.chat.newChatEditor"
    },
    {
        "key": "ctrl+alt+k", 
        "command": "inlineChat.start"
    },
    {
        "key": "ctrl+alt+shift+l",
        "command": "workbench.action.chat.openInSidebar"
    },
    {
        "key": "ctrl+alt+e",
        "command": "workbench.action.showCommands"
    },
    
    // Disable original AI bindings to prevent conflicts
    {
        "key": "ctrl+i",
        "command": "-composerMode.agent"
    },
    {
        "key": "ctrl+l",
        "command": "-workbench.action.chat.newChatEditor"
    },
    {
        "key": "ctrl+k",
        "command": "-inlineChat.start" 
    },

    {
        "key": "\\",
        "command": "workbench.action.toggleSidebarVisibility",
    },
    {
        "key": "ctrl+n", "command": "workbench.action.quickOpenSelectNext", "when": "inQuickOpen"
    },
    {
        "key": "ctrl+p", "command": "workbench.action.quickOpenSelectPrevious", "when": "inQuickOpen"
    },
    {
        "key": "ctrl+y", "command": "workbench.action.acceptSelectedQuickOpenItem", "when": "inQuickOpen"
    },
    
    // Fix Ctrl+U/D to center cursor properly with vscode-neovim
    {
        "key": "ctrl+u",
        "command": "vscode-neovim.send",
        "args": "<C-u>zz",
        "when": "neovim.mode == normal"
    },
    {
        "key": "ctrl+d", 
        "command": "vscode-neovim.send",
        "args": "<C-d>zz",
        "when": "neovim.mode == normal"
    },

    // ========================================
    // FILE EXPLORER HJKL NAVIGATION (FIXED)
    // ========================================
    
    // File Explorer navigation with hjkl
    {
        "key": "h",
        "command": "list.collapse",
        "when": "explorerViewletVisible && filesExplorerFocus && !inputFocus"
    },
    {
        "key": "l",
        "command": "list.toggleExpand",
        "when": "explorerViewletVisible && filesExplorerFocus && !inputFocus"
    },
    {
        "key": "j", 
        "command": "list.focusDown",
        "when": "explorerViewletVisible && filesExplorerFocus && !inputFocus"
    },
    {
        "key": "k",
        "command": "list.focusUp", 
        "when": "explorerViewletVisible && filesExplorerFocus && !inputFocus"
    },
    
    // Additional file explorer shortcuts
    {
        "key": "o",
        "command": "explorer.openToSide",
        "when": "explorerViewletVisible && filesExplorerFocus && !inputFocus"
    },
    {
        "key": "enter",
        "command": "list.toggleExpand",
        "when": "explorerViewletVisible && filesExplorerFocus && !inputFocus"
    },
    {
        "key": "space",
        "command": "explorer.openToSide",
        "when": "explorerViewletVisible && filesExplorerFocus && !inputFocus"
    },
    
    // File explorer actions
    {
        "key": "a",
        "command": "explorer.newFile",
        "when": "explorerViewletVisible && filesExplorerFocus && !inputFocus"
    },
    {
        "key": "shift+a",
        "command": "explorer.newFolder",
        "when": "explorerViewletVisible && filesExplorerFocus && !inputFocus"
    },
    {
        "key": "d",
        "command": "deleteFile",
        "when": "explorerViewletVisible && filesExplorerFocus && !inputFocus"
    },
    {
        "key": "r",
        "command": "renameFile",
        "when": "explorerViewletVisible && filesExplorerFocus && !inputFocus"
    },
    {
        "key": "y",
        "command": "filesExplorer.copy",
        "when": "explorerViewletVisible && filesExplorerFocus && !inputFocus"
    },
    {
        "key": "p",
        "command": "filesExplorer.paste",
        "when": "explorerViewletVisible && filesExplorerFocus && !inputFocus"
    },
    {
        "key": "x",
        "command": "filesExplorer.cut",
        "when": "explorerViewletVisible && filesExplorerFocus && !inputFocus"
    },

    // ========================================
    // RETURN TO EDITOR FROM FILE EXPLORER  
    // ========================================
    
    // Return to editor without opening anything
    {
        "key": "escape",
        "command": "workbench.action.focusActiveEditorGroup",
        "when": "explorerViewletVisible && filesExplorerFocus && !inputFocus"
    },
    {
        "key": "q",
        "command": "workbench.action.focusActiveEditorGroup", 
        "when": "explorerViewletVisible && filesExplorerFocus && !inputFocus"
    },
    {
        "key": "ctrl+[",
        "command": "workbench.action.focusActiveEditorGroup",
        "when": "explorerViewletVisible && filesExplorerFocus && !inputFocus"
    },

    // ========================================
    // FIXED FOCUS MANAGEMENT (CTRL+W+HJKL)
    // ========================================
    
    // Neovim-style window navigation Ctrl+W+hjkl
    {
        "key": "ctrl+w h",
        "command": "workbench.action.focusLeftGroup",
        "when": "!terminalFocus && !filesExplorerFocus && !inChat"
    },
    {
        "key": "ctrl+w l", 
        "command": "workbench.action.focusRightGroup",
        "when": "!terminalFocus && !filesExplorerFocus && !inChat"
    },
    {
        "key": "ctrl+w j",
        "command": "workbench.action.focusBelowGroup",
        "when": "!terminalFocus && !filesExplorerFocus && !inChat"
    },
    {
        "key": "ctrl+w k",
        "command": "workbench.action.focusAboveGroup", 
        "when": "!terminalFocus && !filesExplorerFocus && !inChat"
    },
    
    // Focus sidebar/explorer from editor
    {
        "key": "ctrl+w h",
        "command": "workbench.action.focusSideBar",
        "when": "editorFocus && sideBarVisible"
    },
    
    // Focus editor from sidebar
    {
        "key": "ctrl+w l",
        "command": "workbench.action.focusActiveEditorGroup",
        "when": "sideBarFocus"
    },
    
    // Focus chat from editor (using Space+c instead of Ctrl+W+L to avoid conflicts)
    {
        "key": "space c",
        "command": "workbench.action.chat.focusInput",
        "when": "editorFocus"
    },
    
    // FIXED: Multiple ways to escape from AI chat input
    {
        "key": "escape",
        "command": "workbench.action.focusActiveEditorGroup",
        "when": "inChat"
    },
    {
        "key": "ctrl+w h",
        "command": "workbench.action.focusActiveEditorGroup",
        "when": "inChat"
    },
    {
        "key": "ctrl+[",
        "command": "workbench.action.focusActiveEditorGroup",
        "when": "inChat"
    },

    // ========================================
    // SIDEBAR NAVIGATION SHORTCUTS
    // ========================================
    
    // Quick access to sidebar sections
    {
        "key": "space e",
        "command": "workbench.view.explorer",
        "when": "!inChat"
    },
    {
        "key": "space g",
        "command": "workbench.view.scm",
        "when": "!inChat"  
    },
    {
        "key": "space c",
        "command": "workbench.action.chat.openInSidebar",
        "when": "!inChat && !chatViewVisible"
    },

    // ========================================
    // NEOVIM-STYLE SPACE LEADER KEYBINDINGS
    // ========================================
    
    // Search group - <leader>s*
    {
        "key": "space s f",
        "command": "workbench.action.quickOpen",
        "when": "!inChat"
    },
    {
        "key": "space space",
        "command": "workbench.action.showAllEditors",
        "when": "!inChat"
    },
    {
        "key": "space /",
        "command": "actions.find",
        "when": "!inChat"
    },
    {
        "key": "space s g",
        "command": "workbench.action.findInFiles",
        "when": "!inChat"
    },
    {
        "key": "space s w",
        "command": "editor.action.addSelectionToNextFindMatch",
        "when": "!inChat"
    },
    {
        "key": "space s .",
        "command": "workbench.action.openRecent",
        "when": "!inChat"
    },
    {
        "key": "space s h",
        "command": "workbench.action.showCommands",
        "when": "!inChat"
    },
    {
        "key": "space s k",
        "command": "workbench.action.openGlobalKeybindings",
        "when": "!inChat"
    },
    {
        "key": "space s d",
        "command": "workbench.actions.view.problems",
        "when": "!inChat"
    },
    {
        "key": "space s r",
        "command": "workbench.action.findInFiles",
        "when": "!inChat"
    },
    {
        "key": "space s t",
        "command": "workbench.action.selectTheme",
        "when": "!inChat"
    },
    {
        "key": "space s n",
        "command": "workbench.action.openSettingsJson",
        "when": "!inChat"
    },

    // Diagnostics and quickfix
    {
        "key": "space q",
        "command": "workbench.actions.view.problems",
        "when": "!inChat"
    },

    // Toggle group - <leader>t*
    {
        "key": "space t f",
        "command": "workbench.action.toggleZenMode",
        "when": "!inChat"
    },
    {
        "key": "space t s",
        "command": "workbench.action.toggleSidebarVisibility",
        "when": "!inChat"
    },
    {
        "key": "space t t",
        "command": "workbench.action.terminal.toggleTerminal",
        "when": "!inChat"
    },
    {
        "key": "space t p",
        "command": "workbench.action.togglePanel",
        "when": "!inChat"
    },
    {
        "key": "space t m",
        "command": "editor.action.toggleMinimap",
        "when": "!inChat"
    },

    // File operations  
    {
        "key": "space f f",
        "command": "workbench.action.quickOpen",
        "when": "!inChat"
    },
    {
        "key": "space f r",
        "command": "workbench.action.openRecent",
        "when": "!inChat"
    },
    {
        "key": "space f s",
        "command": "workbench.action.files.save",
        "when": "!inChat"
    },
    {
        "key": "space f a",
        "command": "workbench.action.files.saveAll",
        "when": "!inChat"
    },

    // Buffer operations (similar to your <leader><leader> binding)
    {
        "key": "space b b",
        "command": "workbench.action.showAllEditors",
        "when": "!inChat"
    },
    {
        "key": "space b d",
        "command": "workbench.action.closeActiveEditor",
        "when": "!inChat"
    },
    {
        "key": "space b n",
        "command": "workbench.action.nextEditor",
        "when": "!inChat"
    },
    {
        "key": "space b p",
        "command": "workbench.action.previousEditor",
        "when": "!inChat"
    },

    // Your existing custom bindings
    {
        "key": "\\",
        "command": "workbench.action.toggleSidebarVisibility",
    },
    {
        "key": "ctrl+n", "command": "workbench.action.quickOpenSelectNext", "when": "inQuickOpen"
    },
    {
        "key": "ctrl+p", "command": "workbench.action.quickOpenSelectPrevious", "when": "inQuickOpen"
    },
    {
        "key": "ctrl+y", "command": "workbench.action.acceptSelectedQuickOpenItem", "when": "inQuickOpen"
    }
] 